[Unit]
Description=Tengyunzi paid order watcher via Hermes and Feishu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.hermes/scripts
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/python3 /root/.hermes/scripts/tengyunzi_ops.py check
ExecStart=/usr/bin/python3 /root/.hermes/scripts/tengyunzi_ops.py watch --poll-seconds 10
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/.hermes

[Install]
WantedBy=multi-user.target
